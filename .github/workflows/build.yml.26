
  build-26:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        mc: ['26.1', '26.1.1', '26.1.2', '26.2', '26.3']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: 25 }
      - uses: gradle/actions/setup-gradle@v4
        with: { gradle-version: 9.5.1 }
      - name: Use 26.x build files
        run: |
          cp build26.gradle build.gradle
          cp settings26.gradle settings.gradle
          cp gradle26.properties gradle.properties
      - run: gradle build -Pminecraft_version=${{ matrix.mc }}
      - uses: actions/upload-artifact@v4
        with:
          name: elektryn-${{ matrix.mc }}
          path: build/libs/elektryn-*.jar
